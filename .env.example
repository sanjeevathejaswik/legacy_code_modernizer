# Azure OpenAI Configuration
# Copy this file to .env and fill in your values.
# The API key must be set as an environment variable before running:
#   PowerShell : $env:AZURE_OPENAI_KEY_GPT4o = "<your-key>"
#   Bash/CMD   : export AZURE_OPENAI_KEY_GPT4o=<your-key>

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_KEY_GPT4o=<your-api-key>

# Pipeline Configuration
MAX_AUDIT_RETRIES=2
AUDIT_PASS_THRESHOLD=70.0
OUTPUT_DIR=output

# Build Verification
MAX_BUILD_RETRIES=1
BUILD_TIMEOUT_SECS=120
